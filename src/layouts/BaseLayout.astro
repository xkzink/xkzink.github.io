---
import "../assets/css/reset.css";
import "../assets/css/common.css";
import "../App.css";
import ParticlesBackgroundIsland from "../components/ParticlesBackgroundIsland.jsx";

const {
  title = "Welcome | Xinkai Lin",
  description = "Xinkai Lin is a developer in New York who likes games, guitar, travel, and photography.",
  activePath = "/home",
} = Astro.props;

const navItems = [
  { label: "Home", href: "/home" },
  { label: "Photos", href: "/photo" },
  { label: "Games", href: "/games" },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <div class="index">
      <header class="el-header w clearfix">
        <div class="my-name">
          <h1>
            <a class="name" href="/home" aria-label="Xinkai Lin home">Xinkai Lin</a>
          </h1>
        </div>
        <div class="my-link">
          <nav aria-label="Primary navigation">
            <ul>
              {
                navItems.map((item) => (
                  <li>
                    <a class:list={["link-color", activePath === item.href && "active-router"]} href={item.href}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </header>

      <main class="el-main w">
        <slot />
      </main>

      <footer class="el-footer w">
        <div class="links">
          <nav aria-label="Social links">
            <ul>
              <li>
                <a href="https://www.linkedin.com/in/xinkailin/" target="_blank" rel="noreferrer">LinkedIn</a>
              </li>
              <li>
                <a href="https://www.instagram.com/xinkai00007/" target="_blank" rel="noreferrer">Instagram</a>
              </li>
              <li class="lastLi">
                <a href="mailto:xinkailin1995@gmail.com"> Email</a>
              </li>
            </ul>
          </nav>
        </div>
        <div class="copy-right">&copy; Xinkai Lin. All Rights Reserved {year}</div>
      </footer>

      <ParticlesBackgroundIsland client:load />
    </div>
  </body>
</html>
