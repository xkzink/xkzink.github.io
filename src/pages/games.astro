---
import BaseLayout from "../layouts/BaseLayout.astro";
import { gameList } from "../data";
---

<BaseLayout title="Games | Xinkai Lin" activePath="/games">
  <div class="games">
    {
      gameList.map((item) => (
        <ul class="content">
          <li>
            <div class="img">
              <a href={item.link} target="_blank" rel="noreferrer">
                <img src={item.src.src ?? item.src} alt={item.alt} />
              </a>
            </div>
            <div class="info">
              <a href={item.link} target="_blank" rel="noreferrer">
                <div class="desc">{item.title}</div>
              </a>
            </div>
          </li>
        </ul>
      ))
    }
  </div>
</BaseLayout>
