---
import BaseLayout from "../layouts/BaseLayout.astro";
import { gameList } from "../data";
---

<BaseLayout title="Games | Xinkai Lin" activePath="/games">
  <section class="page-intro">
    <p class="section-label">Games</p>
    <h1>Small projects and interactive experiments.</h1>
  </section>

  <section class="project-list" aria-label="Games and projects">
    {
      gameList.map((item) => (
        <article class="project-card">
          <a class="project-image-link" href={item.link} target="_blank" rel="noreferrer">
            <img src={item.src.src ?? item.src} alt={item.alt} loading="lazy" decoding="async" />
          </a>
          <div class="project-copy">
            <h2>{item.title}</h2>
            <a class="text-link" href={item.link} target="_blank" rel="noreferrer">Visit project</a>
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
